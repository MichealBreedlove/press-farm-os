# ============================================
# Press Farm OS — Environment Variables
#
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
#
# Get these values from:
# - Supabase: https://supabase.com/dashboard → Project Settings → API
# - Resend: https://resend.com/api-keys
# ============================================

# ---- Supabase ----
# Found in: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Found in: Project Settings → API → Project API keys → anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Found in: Project Settings → API → Project API keys → service_role
# SERVER SIDE ONLY — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Resend ----
# Found in: https://resend.com/api-keys
# SERVER SIDE ONLY
RESEND_API_KEY=re_your_api_key_here

# ---- App ----
# Production: https://pressfarm.app
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Sentry (error monitoring) ----
# Optional — error capture stays OFF until the DSN is set.
# Create a (free-tier) Next.js project at https://sentry.io, then copy the
# DSN from: Project Settings → Client Keys (DSN). Safe to expose publicly.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Only needed for readable stack traces (source-map upload during build):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_your_token   # SERVER/CI ONLY

# ---- Email override (testing) ----
# When set, EVERY outbound email — test, weekly digest, order confirmations,
# chef welcome, receiver daily, timesheet — is rerouted to this address(es).
# Original recipient is preserved in the subject ("[→ chef@x.com] …") and
# in the X-PF-Original-To header so you can verify routing.
# Comma-separated for multiple. LEAVE UNSET in production.
# EMAIL_OVERRIDE_TO=mikejohnbreedlove@gmail.com
